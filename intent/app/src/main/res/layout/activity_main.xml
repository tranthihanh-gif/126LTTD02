<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Màn hình 1 - Nhập thông tin"
        android:textSize="22sp" android:textStyle="bold" />

    <EditText android:id="@+id/edtId"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="MSSV" />

    <EditText android:id="@+id/edtName"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Họ tên" />

    <EditText android:id="@+id/edtGpa"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="GPA"
        android:inputType="numberDecimal" />

    <Button android:id="@+id/btnSend"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Gửi sang màn hình 2" />
</LinearLayout>